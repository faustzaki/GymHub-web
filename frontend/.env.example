VITE_API_BASE_URL=http://127.0.0.1:8001/api

# Masuk otomatis saat `npm run dev` (opsional). Salin ke .env.local, JANGAN di-commit.
# Isi dari akun hasil seeder: php artisan db:seed
# Akun untuk masuk otomatis selama pengembangan. Isi akun OWNER, bukan petugas:
# di dev semua layar jadi bisa dibuka (owner bertingkat, boleh masuk /admin/* juga).
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=
